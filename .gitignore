# Local datasets
/data/*
!/data/.gitkeep

# Allow only the official raw UMWP benchmark
!/data/raw/
/data/raw/*
!/data/raw/umwp/
/data/raw/umwp/*
!/data/raw/umwp/StandardDataset.jsonl

# Allow only the corrected raw MATE benchmark
!/data/raw/mate/
/data/raw/mate/*
!/data/raw/mate/MATE Dataset.csv

# Allow only the final processed SUM experiment splits
!/data/processed/
/data/processed/*
!/data/processed/sum/
/data/processed/sum/*
!/data/processed/sum/train.csv
!/data/processed/sum/validation.csv
!/data/processed/sum/test.csv

# Allow only the processed UMWP external evaluation dataset
!/data/processed/umwp/
/data/processed/umwp/*
!/data/processed/umwp/test.csv

# Allow only the fixed processed MATE benchmark and exclusion ledger
!/data/processed/mate/
/data/processed/mate/*
!/data/processed/mate/test.csv
!/data/processed/mate/excluded_pairs.csv

# Model checkpoints and weights
/models/
checkpoints/
checkpoint-*/
*.pt
*.pth
*.ckpt
*.safetensors
pytorch_model*.bin

